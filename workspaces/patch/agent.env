# Daemon settings for Patch's agency daemon. The launchd job (rollout step 4)
# loads this file; the workspace itself cannot set them.
AGENCY_AGENT_ID=patch
# The agency-tools and contracts the box runs, as scripts/sync_agency_tools.sh
# installs them (launchd, every 10 minutes). The daemon starts through
# scripts/run_on_release.sh, which resolves `current` once to the real release
# path, so a sync never swaps code under a running daemon.
AGENCY_TOOLS_ROOT=/Volumes/SSD/agency-runtime/current/agency-tools
AGENCY_PYTHON_BINARY=/Volumes/SSD/agency-runtime/current/agency-tools/.venv/bin/python
AGENCY_CONTRACTS_DIR=/Volumes/SSD/agency-runtime/current/contracts
# Two runs at once: e.g. a build and a plan. The board check never dispatches
# more than this (slots.patch summed over every board in boards.json must match).
MAX_CONCURRENT_RUNS=2
# Required: the run-concurrency gate and the stage rules' single-flight locks
# (one job per card) live here. Patch's own database: Agency's keys are not
# namespaced by agent, so Patch and Scarlett never share one.
REDIS_URL=redis://127.0.0.1:6379/1
# The GitHub login a Blocked card's comment mentions (board.block). Not a secret.
BOARD_NOTIFY_LOGIN=ctcreel
# The run token `gh` and git use in Patch's Bash: the sc0red-patch App's
# installation token for the card's repo, minted with exactly these
# permissions. No Projects permission (organization_projects or
# repository_projects), so only the board tools, which hold their own token,
# can move a card.
GITHUB_RUN_TOKEN_APP=sc0red-patch
GITHUB_RUN_TOKEN_PERMISSIONS=contents:write,pull_requests:write,issues:write,workflows:write,actions:read,checks:read,statuses:read,metadata:read
# The daemon on this Mac (launchd/com.sc0red.agency-daemon.plist, installed by
# `make install-daemon AGENT=patch`). The launcher sources this file in bash,
# so a value with JSON in it is single-quoted. Ports: Patch 8810, Scarlett 8811.
PORT=8810
# Loopback only: every caller (the board tools, Scarlett's daemon) is on this
# Mac, and nothing comes in from the network: 127.0.0.1, not 0.0.0.0.
AGENCY_BIND_LOOPBACK=true
SERVICE_NAME=agency-patch
# The tools' python is the python.org framework build, which carries no CA
# bundle of its own (HTTPS fails CERTIFICATE_VERIFY_FAILED): macOS's system
# bundle. Agency passes SSL_CERT_FILE to every child it spawns.
SSL_CERT_FILE=/etc/ssl/cert.pem
LOG_FORMAT=json
LOG_LEVEL=info
AGENCY_WORKSPACE_DIR=/Volumes/SSD/agency-runtime/workspaces/patch
AGENCY_API_BASE_URL=http://127.0.0.1:8810
AGENCY_LISTENER_URL=http://127.0.0.1:8810
AGENCY_AGENT_URLS='{"patch":"http://127.0.0.1:8810","scarlett":"http://127.0.0.1:8811"}'
AGENCY_MCP_SERVER_SCRIPT=/Volumes/SSD/agency-runtime/agency/scripts/agency_mcp_server.py
# Linux defaults are /var/log/agency-<agent>/; on this Mac each daemon's own
# directory on the SSD.
AGENCY_AUDIT_LOG_PATH=/Volumes/SSD/agency-runtime/patch/audit.log
AGENCY_EVENTS_BUFFER_PATH=/Volumes/SSD/agency-runtime/patch/events-buffer.jsonl
# Secrets: key -> op:// reference (no values), resolved by Agency's
# SecretManager with the service account whose token is in this login-keychain
# item. The token is the 1Password item "Service Account Auth Token: The
# Agency" (Engineering vault). The bindings name "GitHub App: sc0red-patch" by
# its item id, 5dmazffzr2wuz65kpxo4yq3czm: an op:// reference cannot hold ':'.
AGENCY_OP_BINDINGS_FILE=/Volumes/SSD/agency-runtime/workspaces/patch/op-bindings.json
OP_SERVICE_ACCOUNT_KEYCHAIN_ITEM=sc0red-agency-op-service-account
