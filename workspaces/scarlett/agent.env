# Daemon settings for Scarlett's agency daemon. The launchd job (rollout step
# 4) loads this file; the workspace itself cannot set them.
AGENCY_AGENT_ID=scarlett
# One review at a time (each board.sweep slots.scarlett in Patch's agency.yaml must match).
MAX_CONCURRENT_RUNS=1
# Required: the run-concurrency gate and the stage rules' single-flight locks
# (one job per card) live here. Scarlett's own database: Agency's keys are not
# namespaced by agent, so Patch and Scarlett never share one.
REDIS_URL=redis://127.0.0.1:6379/2
# The GitHub login a Blocked card's comment mentions (board.block). Not a secret.
BOARD_NOTIFY_LOGIN=ctcreel
# The run token `gh` and git use in Scarlett's runs: the sc0red-scarlett App's
# installation token for the card's repo, minted with exactly these
# permissions. No Projects permission and no contents write: she reads the PR
# head and pushes nothing. Her scarlett/review status is posted by the gate's
# scarlett-review, which mints its own statuses-only token.
GITHUB_RUN_TOKEN_APP=sc0red-scarlett
GITHUB_RUN_TOKEN_PERMISSIONS=contents:read,pull_requests:read,issues:write,actions:read,checks:read,statuses:read,metadata:read
